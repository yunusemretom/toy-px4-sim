<?xml version="1.0"?>
<!-- ArduPilot surumu (tools/gen_ardupilot.py).  X-UAV Talon: tools/gen_plane.py ile uretildi (tanim: tools/plane_specs.py). Elle duzenlemeyin.
     S=0.601 m^2, MAC=0.352 m, AR=4.91, kutle=2.8 kg
     Notr nokta burundan 0.467 m, agirlik merkezi 0.431 m (statik marj %10 MAC)
     Trim: vtail.incidence=-4.09 deg, seyir CL=0.34 @ 15 m/s, alpha=1.9 deg -->
<sdf version="1.9">
  <model name="talon_ap">
    <pose>0 0 0.122 0 0 0</pose>
    <link name="base_link">
      <inertial><mass>2.8</mass><inertia><ixx>0.1912</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.1084</iyy><iyz>0</iyz><izz>0.2888</izz></inertia></inertial>
      <collision name="base_link_collision"><pose>-0.099 0 -0.022 0 0 0</pose>
        <geometry><box><size>1.060 0.130 0.140</size></box></geometry>
        <surface><contact><ode><max_vel>10</max_vel><min_depth>0.01</min_depth></ode></contact>
          <friction><ode><mu>0.1</mu><mu2>0.1</mu2></ode></friction></surface></collision>
      <visual name='fuselage_visual'><pose>0 0 0 0 0 0</pose><geometry><mesh><uri>model://talon/meshes/fuselage.obj</uri></mesh></geometry><material><ambient>0.330 0.342 0.360 1</ambient><diffuse>0.55 0.57 0.6 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
      <visual name='surfaces_visual'><pose>0 0 0 0 0 0</pose><geometry><mesh><uri>model://talon/meshes/surfaces.obj</uri></mesh></geometry><material><ambient>0.552 0.552 0.552 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
      <gravity>1</gravity>
      <sensor name="imu_sensor" type="imu">
        <pose degrees="true">0 0 0 180 0 0</pose>
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>
    <link name="rotor"><pose>-0.229 0 0.092 0 1.5708 0</pose>
      <inertial><mass>0.02</mass><inertia><ixx>1.5e-04</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.5e-04</iyy><iyz>0</iyz><izz>3e-04</izz></inertia></inertial>
      <visual name="rotor_visual"><geometry><cylinder><length>0.004</length><radius>0.127</radius></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 0.6</ambient><diffuse>0.1 0.1 0.1 0.6</diffuse></material><transparency>0.4</transparency></visual>
    </link>
    <joint name="rotor_joint" type="revolute"><child>rotor</child><parent>base_link</parent>
      <axis><xyz expressed_in="__model__">1 0 0</xyz><limit><lower>-1e+16</lower><upper>1e+16</upper></limit></axis></joint>
    <link name='ail_l'><pose>-0.1877 0.6228 0.0687 0 0 0</pose>
      <inertial><mass>0.00000001</mass><inertia><ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000001</iyy><iyz>0</iyz><izz>0.000001</izz></inertia></inertial>
      <visual name='ail_l_visual'><pose>0.1877 -0.6228 -0.0687 0 0 0</pose><geometry><mesh><uri>model://talon/meshes/ail_l.obj</uri></mesh></geometry><material><ambient>0.570 0.210 0.030 1</ambient><diffuse>0.95 0.35 0.05 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
    </link>
    <link name='ail_r'><pose>-0.1877 -0.6228 0.0687 0 0 0</pose>
      <inertial><mass>0.00000001</mass><inertia><ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000001</iyy><iyz>0</iyz><izz>0.000001</izz></inertia></inertial>
      <visual name='ail_r_visual'><pose>0.1877 0.6228 -0.0687 0 0 0</pose><geometry><mesh><uri>model://talon/meshes/ail_r.obj</uri></mesh></geometry><material><ambient>0.570 0.210 0.030 1</ambient><diffuse>0.95 0.35 0.05 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
    </link>
    <link name='rv_l'><pose>-0.5606 0.1238 0.1234 0 0 0</pose>
      <inertial><mass>0.00000001</mass><inertia><ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000001</iyy><iyz>0</iyz><izz>0.000001</izz></inertia></inertial>
      <visual name='rv_l_visual'><pose>0.5606 -0.1238 -0.1234 0 0 0</pose><geometry><mesh><uri>model://talon/meshes/rv_l.obj</uri></mesh></geometry><material><ambient>0.570 0.210 0.030 1</ambient><diffuse>0.95 0.35 0.05 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
    </link>
    <link name='rv_r'><pose>-0.5606 -0.1238 0.1234 0 0 0</pose>
      <inertial><mass>0.00000001</mass><inertia><ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000001</iyy><iyz>0</iyz><izz>0.000001</izz></inertia></inertial>
      <visual name='rv_r_visual'><pose>0.5606 0.1238 -0.1234 0 0 0</pose><geometry><mesh><uri>model://talon/meshes/rv_r.obj</uri></mesh></geometry><material><ambient>0.570 0.210 0.030 1</ambient><diffuse>0.95 0.35 0.05 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
    </link>
    <joint name='servo_0' type='revolute'><parent>base_link</parent><child>ail_l</child>
      <axis><xyz expressed_in='__model__'>-0.0173 -0.9990 -0.0418</xyz><limit><lower>-0.44</lower><upper>0.44</upper></limit><dynamics><damping>1.0</damping></dynamics></axis>
      <physics><ode><implicit_spring_damper>1</implicit_spring_damper></ode></physics></joint>
    <joint name='servo_1' type='revolute'><parent>base_link</parent><child>ail_r</child>
      <axis><xyz expressed_in='__model__'>0.0173 -0.9990 0.0418</xyz><limit><lower>-0.44</lower><upper>0.44</upper></limit><dynamics><damping>1.0</damping></dynamics></axis>
      <physics><ode><implicit_spring_damper>1</implicit_spring_damper></ode></physics></joint>
    <joint name='servo_2' type='revolute'><parent>base_link</parent><child>rv_l</child>
      <axis><xyz expressed_in='__model__'>0.0150 -0.8036 -0.5950</xyz><limit><lower>-0.44</lower><upper>0.44</upper></limit><dynamics><damping>1.0</damping></dynamics></axis>
      <physics><ode><implicit_spring_damper>1</implicit_spring_damper></ode></physics></joint>
    <joint name='servo_3' type='revolute'><parent>base_link</parent><child>rv_r</child>
      <axis><xyz expressed_in='__model__'>-0.0150 -0.8036 0.5950</xyz><limit><lower>-0.44</lower><upper>0.44</upper></limit><dynamics><damping>1.0</damping></dynamics></axis>
      <physics><ode><implicit_spring_damper>1</implicit_spring_damper></ode></physics></joint>
    <plugin filename='gz-sim-joint-position-controller-system' name='gz::sim::systems::JointPositionController'><joint_name>servo_0</joint_name><sub_topic>servo_0</sub_topic><p_gain>10</p_gain><i_gain>0</i_gain><d_gain>0</d_gain></plugin>
    <plugin filename='gz-sim-joint-position-controller-system' name='gz::sim::systems::JointPositionController'><joint_name>servo_1</joint_name><sub_topic>servo_1</sub_topic><p_gain>10</p_gain><i_gain>0</i_gain><d_gain>0</d_gain></plugin>
    <plugin filename='gz-sim-joint-position-controller-system' name='gz::sim::systems::JointPositionController'><joint_name>servo_2</joint_name><sub_topic>servo_2</sub_topic><p_gain>10</p_gain><i_gain>0</i_gain><d_gain>0</d_gain></plugin>
    <plugin filename='gz-sim-joint-position-controller-system' name='gz::sim::systems::JointPositionController'><joint_name>servo_3</joint_name><sub_topic>servo_3</sub_topic><p_gain>10</p_gain><i_gain>0</i_gain><d_gain>0</d_gain></plugin>
    <plugin filename="gz-sim-advanced-lift-drag-system" name="gz::sim::systems::AdvancedLiftDrag">
      <CL0>0.19658</CL0>
      <CLa>4.24903</CLa>
      <AR>4.90857</AR>
      <eff>0.5738</eff>
      <CD0>0.0301927</CD0>
      <Cem0>0.01442</Cem0>
      <Cema>-0.408651</Cema>
      <CYb>-0.156879</CYb>
      <Cellb>-0.066733</Cellb>
      <Cenb>0.035642</Cenb>
      <CYp>-0.013943</CYp>
      <CLp>-4.7e-05</CLp>
      <Cellp>-0.39051</Cellp>
      <Cemp>-5e-06</Cemp>
      <Cenp>-0.008628</Cenp>
      <CYq>2e-06</CYq>
      <CLq>5.6648</CLq>
      <Cellq>2e-05</Cellq>
      <Cemq>-2.41292</Cemq>
      <Cenq>-6e-06</Cenq>
      <CYr>0.08454</CYr>
      <CLr>4e-06</CLr>
      <Cellr>0.077892</Cellr>
      <Cemr>0</Cemr>
      <Cenr>-0.024596</Cenr>
      <CDp>-3.1e-05</CDp>
      <CDq>0.099775</CDq>
      <CDr>-0</CDr>
      <alpha_stall>0.192</alpha_stall>
      <CLa_stall>-3.85</CLa_stall><CDa_stall>-0.92</CDa_stall><Cema_stall>0</Cema_stall>
      <cp>0 0 0</cp><area>0.6013</area><mac>0.3524</mac><air_density>1.2041</air_density>
      <forward>1 0 0</forward><upward>0 0 1</upward><link_name>base_link</link_name>
      <num_ctrl_surfaces>4</num_ctrl_surfaces>
      <control_surface><name>servo_0</name><index>0</index><direction>1</direction><CD_ctrl>0.000296</CD_ctrl><CY_ctrl>0.000174</CY_ctrl><CL_ctrl>0.008327</CL_ctrl><Cell_ctrl>0.002247</Cell_ctrl><Cem_ctrl>-0.002503</Cem_ctrl><Cen_ctrl>-7.1e-05</Cen_ctrl></control_surface>
      <control_surface><name>servo_1</name><index>1</index><direction>1</direction><CD_ctrl>0.000296</CD_ctrl><CY_ctrl>-0.000174</CY_ctrl><CL_ctrl>0.008326</CL_ctrl><Cell_ctrl>-0.002247</Cell_ctrl><Cem_ctrl>-0.002503</Cem_ctrl><Cen_ctrl>7.1e-05</Cen_ctrl></control_surface>
      <control_surface><name>servo_2</name><index>2</index><direction>1</direction><CD_ctrl>-0.000118</CD_ctrl><CY_ctrl>0.001407</CY_ctrl><CL_ctrl>0.003851</CL_ctrl><Cell_ctrl>0.000255</Cell_ctrl><Cem_ctrl>-0.004752</Cem_ctrl><Cen_ctrl>-0.000436</Cen_ctrl></control_surface>
      <control_surface><name>servo_3</name><index>3</index><direction>1</direction><CD_ctrl>-0.000118</CD_ctrl><CY_ctrl>-0.001407</CY_ctrl><CL_ctrl>0.003851</CL_ctrl><Cell_ctrl>-0.000255</Cell_ctrl><Cem_ctrl>-0.004752</Cem_ctrl><Cen_ctrl>0.000436</Cen_ctrl></control_surface>
    </plugin>
    <link name="camera_link"><pose>0.441 0 -0.022 0 0.26 0</pose>
      <inertial><mass>0.03</mass><inertia><ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00001</iyy><iyz>0</iyz><izz>0.00001</izz></inertia></inertial>
      <sensor name="camera" type="camera"><gz_frame_id>camera_link</gz_frame_id>
        <camera><horizontal_fov>1.5708</horizontal_fov><image><width>640</width><height>480</height></image>
          <clip><near>0.1</near><far>1500</far></clip></camera>
        <always_on>1</always_on><update_rate>20</update_rate><visualize>false</visualize></sensor>
    </link>
    <joint name="CameraJoint" type="fixed"><parent>base_link</parent><child>camera_link</child></joint>

    <!-- Motor: ArduPilot gaz kanali itkiyi (N, 0..30) dogrudan komut eder. -->
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <namespace>talon_ap</namespace>
      <joint_name>rotor_joint</joint_name>
      <thrust_coefficient>0.1</thrust_coefficient>
      <fluid_density>1.2041</fluid_density>
      <propeller_diameter>0.254</propeller_diameter>
      <max_thrust_cmd>30.00</max_thrust_cmd>
      <min_thrust_cmd>0</min_thrust_cmd>
    </plugin>
    <!-- ArduPilot JSON koprusu. Govde ekseni x ileri / y sola / z yukari -> FRD icin x etrafinda
         180 deg; dunya ENU -> NED. fdm_port_in cok aracli calistirmada ornek basina degistirilir. -->
    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>
      <imuName>imu_sensor</imuName>
      <control channel="0">
        <jointName>servo_0</jointName>
        <type>COMMAND</type>
        <cmd_topic>/model/talon_ap/servo_0</cmd_topic>
        <multiplier>0.8727</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
      </control>
      <control channel="1">
        <jointName>servo_1</jointName>
        <type>COMMAND</type>
        <cmd_topic>/model/talon_ap/servo_1</cmd_topic>
        <multiplier>-0.8727</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
      </control>
      <control channel="2">
        <jointName>servo_2</jointName>
        <type>COMMAND</type>
        <cmd_topic>/model/talon_ap/servo_2</cmd_topic>
        <multiplier>-0.8727</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
      </control>
      <control channel="3">
        <jointName>servo_3</jointName>
        <type>COMMAND</type>
        <cmd_topic>/model/talon_ap/servo_3</cmd_topic>
        <multiplier>-0.8727</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
      </control>
      <control channel="4">
        <jointName>rotor_joint</jointName>
        <type>COMMAND</type>
        <cmd_topic>/model/talon_ap/joint/rotor_joint/cmd_thrust</cmd_topic>
        <multiplier>30.00</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
      </control>
    </plugin>
  </model>
</sdf>
