<?xml version="1.0"?>
<!-- tools/gen_world.py ile uretildi, elle duzenlemeyin. -->
<sdf version="1.9">
  <model name="toy_ground">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><plane><normal>0 0 1</normal><size>1600.0 1600.0</size></plane></geometry>
        <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
      </collision>
      <visual name="grass">
        <geometry><mesh><uri>model://toy_ground/meshes/grass.obj</uri></mesh></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
          <pbr><metal>
            <albedo_map>model://toy_ground/materials/textures/grass.png</albedo_map>
            <roughness>0.95</roughness><metalness>0</metalness>
          </metal></pbr>
        </material>
      </visual>
      <visual name="trees_trunk">
        <geometry><mesh><uri>model://toy_ground/meshes/trees_trunk.obj</uri></mesh></geometry>
        <material><ambient>0.210 0.132 0.072 1</ambient><diffuse>0.35 0.22 0.12 1</diffuse>
          <specular>0.02 0.02 0.02 1</specular></material>
      </visual>
      <visual name="trees_leaf">
        <geometry><mesh><uri>model://toy_ground/meshes/trees_leaf.obj</uri></mesh></geometry>
        <material><ambient>0.096 0.240 0.078 1</ambient><diffuse>0.16 0.4 0.13 1</diffuse>
          <specular>0.02 0.02 0.02 1</specular></material>
      </visual>
      <visual name="trees_leaf_light">
        <geometry><mesh><uri>model://toy_ground/meshes/trees_leaf_light.obj</uri></mesh></geometry>
        <material><ambient>0.150 0.288 0.096 1</ambient><diffuse>0.25 0.48 0.16 1</diffuse>
          <specular>0.02 0.02 0.02 1</specular></material>
      </visual>
      <visual name="trees_pine">
        <geometry><mesh><uri>model://toy_ground/meshes/trees_pine.obj</uri></mesh></geometry>
        <material><ambient>0.048 0.168 0.072 1</ambient><diffuse>0.08 0.28 0.12 1</diffuse>
          <specular>0.02 0.02 0.02 1</specular></material>
      </visual>
      <visual name="runway">
        <pose>60.0 0 0.02 0 0 0</pose>
        <geometry><mesh><uri>model://toy_ground/meshes/runway.obj</uri></mesh></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr><metal>
            <albedo_map>model://toy_ground/materials/textures/runway.png</albedo_map>
            <roughness>0.85</roughness><metalness>0</metalness>
          </metal></pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
