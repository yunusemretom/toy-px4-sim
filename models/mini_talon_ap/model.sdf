<?xml version="1.0"?>
<!-- ArduPilot surumu (tools/gen_ardupilot.py).  X-UAV Mini Talon: tools/gen_plane.py ile uretildi (tanim: tools/plane_specs.py). Elle duzenlemeyin.
     S=0.338 m^2, MAC=0.262 m, AR=5.00, kutle=1.6 kg
     Notr nokta burundan 0.353 m, agirlik merkezi 0.326 m (statik marj %10 MAC)
     Trim: vtail.incidence=-3.87 deg, seyir CL=0.34 @ 15 m/s, alpha=1.9 deg -->
<sdf version="1.9">
  <model name="mini_talon_ap">
    <pose>0 0 0.100 0 0 0</pose>
    <link name="base_link">
      <inertial><mass>1.6</mass><inertia><ixx>0.0626</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.0354</iyy><iyz>0</iyz><izz>0.0945</izz></inertia></inertial>
      <collision name="base_link_collision"><pose>-0.074 0 -0.017 0 0 0</pose>
        <geometry><box><size>0.800 0.100 0.105</size></box></geometry>
        <surface><contact><ode><max_vel>10</max_vel><min_depth>0.01</min_depth></ode></contact>
          <friction><ode><mu>0.1</mu><mu2>0.1</mu2></ode></friction></surface></collision>
      <visual name='fuselage_visual'><pose>0 0 0 0 0 0</pose><geometry><mesh><uri>model://mini_talon/meshes/fuselage.obj</uri></mesh></geometry><material><ambient>0.120 0.132 0.150 1</ambient><diffuse>0.2 0.22 0.25 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
      <visual name='surfaces_visual'><pose>0 0 0 0 0 0</pose><geometry><mesh><uri>model://mini_talon/meshes/surfaces.obj</uri></mesh></geometry><material><ambient>0.120 0.132 0.150 1</ambient><diffuse>0.2 0.22 0.25 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
      <gravity>1</gravity>
      <sensor name="imu_sensor" type="imu">
        <pose degrees="true">0 0 0 180 0 0</pose>
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>
    <link name="rotor"><pose>-0.174 0 0.070 0 1.5708 0</pose>
      <inertial><mass>0.02</mass><inertia><ixx>1.5e-04</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.5e-04</iyy><iyz>0</iyz><izz>3e-04</izz></inertia></inertial>
      <visual name="rotor_visual"><geometry><cylinder><length>0.004</length><radius>0.102</radius></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 0.6</ambient><diffuse>0.1 0.1 0.1 0.6</diffuse></material><transparency>0.4</transparency></visual>
    </link>
    <joint name="rotor_joint" type="revolute"><child>rotor</child><parent>base_link</parent>
      <axis><xyz expressed_in="__model__">1 0 0</xyz><limit><lower>-1e+16</lower><upper>1e+16</upper></limit></axis></joint>
    <link name='ail_l'><pose>-0.1377 0.4712 0.0523 0 0 0</pose>
      <inertial><mass>0.00000001</mass><inertia><ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000001</iyy><iyz>0</iyz><izz>0.000001</izz></inertia></inertial>
      <visual name='ail_l_visual'><pose>0.1377 -0.4712 -0.0523 0 0 0</pose><geometry><mesh><uri>model://mini_talon/meshes/ail_l.obj</uri></mesh></geometry><material><ambient>0.570 0.480 0.030 1</ambient><diffuse>0.95 0.8 0.05 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
    </link>
    <link name='ail_r'><pose>-0.1377 -0.4712 0.0523 0 0 0</pose>
      <inertial><mass>0.00000001</mass><inertia><ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000001</iyy><iyz>0</iyz><izz>0.000001</izz></inertia></inertial>
      <visual name='ail_r_visual'><pose>0.1377 0.4712 -0.0523 0 0 0</pose><geometry><mesh><uri>model://mini_talon/meshes/ail_r.obj</uri></mesh></geometry><material><ambient>0.570 0.480 0.030 1</ambient><diffuse>0.95 0.8 0.05 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
    </link>
    <link name='rv_l'><pose>-0.4247 0.0938 0.0931 0 0 0</pose>
      <inertial><mass>0.00000001</mass><inertia><ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000001</iyy><iyz>0</iyz><izz>0.000001</izz></inertia></inertial>
      <visual name='rv_l_visual'><pose>0.4247 -0.0938 -0.0931 0 0 0</pose><geometry><mesh><uri>model://mini_talon/meshes/rv_l.obj</uri></mesh></geometry><material><ambient>0.570 0.480 0.030 1</ambient><diffuse>0.95 0.8 0.05 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
    </link>
    <link name='rv_r'><pose>-0.4247 -0.0938 0.0931 0 0 0</pose>
      <inertial><mass>0.00000001</mass><inertia><ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000001</iyy><iyz>0</iyz><izz>0.000001</izz></inertia></inertial>
      <visual name='rv_r_visual'><pose>0.4247 0.0938 -0.0931 0 0 0</pose><geometry><mesh><uri>model://mini_talon/meshes/rv_r.obj</uri></mesh></geometry><material><ambient>0.570 0.480 0.030 1</ambient><diffuse>0.95 0.8 0.05 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
    </link>
    <joint name='servo_0' type='revolute'><parent>base_link</parent><child>ail_l</child>
      <axis><xyz expressed_in='__model__'>-0.0229 -0.9989 -0.0418</xyz><limit><lower>-0.44</lower><upper>0.44</upper></limit><dynamics><damping>1.0</damping></dynamics></axis>
      <physics><ode><implicit_spring_damper>1</implicit_spring_damper></ode></physics></joint>
    <joint name='servo_1' type='revolute'><parent>base_link</parent><child>ail_r</child>
      <axis><xyz expressed_in='__model__'>0.0229 -0.9989 0.0418</xyz><limit><lower>-0.44</lower><upper>0.44</upper></limit><dynamics><damping>1.0</damping></dynamics></axis>
      <physics><ode><implicit_spring_damper>1</implicit_spring_damper></ode></physics></joint>
    <joint name='servo_2' type='revolute'><parent>base_link</parent><child>rv_l</child>
      <axis><xyz expressed_in='__model__'>0.0324 -0.8027 -0.5955</xyz><limit><lower>-0.44</lower><upper>0.44</upper></limit><dynamics><damping>1.0</damping></dynamics></axis>
      <physics><ode><implicit_spring_damper>1</implicit_spring_damper></ode></physics></joint>
    <joint name='servo_3' type='revolute'><parent>base_link</parent><child>rv_r</child>
      <axis><xyz expressed_in='__model__'>-0.0324 -0.8027 0.5955</xyz><limit><lower>-0.44</lower><upper>0.44</upper></limit><dynamics><damping>1.0</damping></dynamics></axis>
      <physics><ode><implicit_spring_damper>1</implicit_spring_damper></ode></physics></joint>
    <plugin filename='gz-sim-joint-position-controller-system' name='gz::sim::systems::JointPositionController'><joint_name>servo_0</joint_name><sub_topic>servo_0</sub_topic><p_gain>10</p_gain><i_gain>0</i_gain><d_gain>0</d_gain></plugin>
    <plugin filename='gz-sim-joint-position-controller-system' name='gz::sim::systems::JointPositionController'><joint_name>servo_1</joint_name><sub_topic>servo_1</sub_topic><p_gain>10</p_gain><i_gain>0</i_gain><d_gain>0</d_gain></plugin>
    <plugin filename='gz-sim-joint-position-controller-system' name='gz::sim::systems::JointPositionController'><joint_name>servo_2</joint_name><sub_topic>servo_2</sub_topic><p_gain>10</p_gain><i_gain>0</i_gain><d_gain>0</d_gain></plugin>
    <plugin filename='gz-sim-joint-position-controller-system' name='gz::sim::systems::JointPositionController'><joint_name>servo_3</joint_name><sub_topic>servo_3</sub_topic><p_gain>10</p_gain><i_gain>0</i_gain><d_gain>0</d_gain></plugin>
    <plugin filename="gz-sim-advanced-lift-drag-system" name="gz::sim::systems::AdvancedLiftDrag">
      <CL0>0.20027</CL0>
      <CLa>4.28852</CLa>
      <AR>5</AR>
      <eff>0.5947</eff>
      <CD0>0.0301965</CD0>
      <Cem0>0.01472</Cem0>
      <Cema>-0.414436</Cema>
      <CYb>-0.159204</CYb>
      <Cellb>-0.066738</Cellb>
      <Cenb>0.036305</Cenb>
      <CYp>-0.015633</CYp>
      <CLp>-1.2e-05</CLp>
      <Cellp>-0.394778</Cellp>
      <Cemp>1e-06</Cemp>
      <Cenp>-0.008578</Cenp>
      <CYq>-4.7e-05</CYq>
      <CLq>5.72366</CLq>
      <Cellq>7e-06</Cellq>
      <Cemq>-2.50165</Cemq>
      <Cenq>2.1e-05</Cenq>
      <CYr>0.086421</CYr>
      <CLr>-3e-06</CLr>
      <Cellr>0.078354</Cellr>
      <Cemr>2e-06</Cemr>
      <Cenr>-0.02513</Cenr>
      <CDp>7e-06</CDp>
      <CDq>0.101318</CDq>
      <CDr>-1.2e-05</CDr>
      <alpha_stall>0.192</alpha_stall>
      <CLa_stall>-3.85</CLa_stall><CDa_stall>-0.92</CDa_stall><Cema_stall>0</Cema_stall>
      <cp>0 0 0</cp><area>0.3380</area><mac>0.2621</mac><air_density>1.2041</air_density>
      <forward>1 0 0</forward><upward>0 0 1</upward><link_name>base_link</link_name>
      <num_ctrl_surfaces>4</num_ctrl_surfaces>
      <control_surface><name>servo_0</name><index>0</index><direction>1</direction><CD_ctrl>0.000293</CD_ctrl><CY_ctrl>0.000175</CY_ctrl><CL_ctrl>0.008382</CL_ctrl><Cell_ctrl>0.002264</Cell_ctrl><Cem_ctrl>-0.002469</Cem_ctrl><Cen_ctrl>-6.9e-05</Cen_ctrl></control_surface>
      <control_surface><name>servo_1</name><index>1</index><direction>1</direction><CD_ctrl>0.000293</CD_ctrl><CY_ctrl>-0.000175</CY_ctrl><CL_ctrl>0.008382</CL_ctrl><Cell_ctrl>-0.002264</Cell_ctrl><Cem_ctrl>-0.002469</Cem_ctrl><Cen_ctrl>6.9e-05</Cen_ctrl></control_surface>
      <control_surface><name>servo_2</name><index>2</index><direction>1</direction><CD_ctrl>-0.000112</CD_ctrl><CY_ctrl>0.001437</CY_ctrl><CL_ctrl>0.003915</CL_ctrl><Cell_ctrl>0.000262</Cell_ctrl><Cem_ctrl>-0.004935</Cem_ctrl><Cen_ctrl>-0.000447</Cen_ctrl></control_surface>
      <control_surface><name>servo_3</name><index>3</index><direction>1</direction><CD_ctrl>-0.000112</CD_ctrl><CY_ctrl>-0.001437</CY_ctrl><CL_ctrl>0.003915</CL_ctrl><Cell_ctrl>-0.000262</Cell_ctrl><Cem_ctrl>-0.004935</Cem_ctrl><Cen_ctrl>0.000447</Cen_ctrl></control_surface>
    </plugin>
    <link name="camera_link"><pose>0.336 0 -0.017 0 0.26 0</pose>
      <inertial><mass>0.03</mass><inertia><ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00001</iyy><iyz>0</iyz><izz>0.00001</izz></inertia></inertial>
      <sensor name="camera" type="camera"><gz_frame_id>camera_link</gz_frame_id>
        <camera><horizontal_fov>1.5708</horizontal_fov><image><width>640</width><height>480</height></image>
          <clip><near>0.1</near><far>1500</far></clip></camera>
        <always_on>1</always_on><update_rate>20</update_rate><visualize>false</visualize></sensor>
    </link>
    <joint name="CameraJoint" type="fixed"><parent>base_link</parent><child>camera_link</child></joint>

    <!-- Motor: ArduPilot gaz kanali itkiyi (N, 0..18) dogrudan komut eder. -->
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <namespace>mini_talon_ap</namespace>
      <joint_name>rotor_joint</joint_name>
      <thrust_coefficient>0.1</thrust_coefficient>
      <fluid_density>1.2041</fluid_density>
      <propeller_diameter>0.204</propeller_diameter>
      <max_thrust_cmd>18.00</max_thrust_cmd>
      <min_thrust_cmd>0</min_thrust_cmd>
    </plugin>
    <!-- ArduPilot JSON koprusu. Govde ekseni x ileri / y sola / z yukari -> FRD icin x etrafinda
         180 deg; dunya ENU -> NED. fdm_port_in cok aracli calistirmada ornek basina degistirilir. -->
    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>
      <imuName>imu_sensor</imuName>
      <control channel="0">
        <jointName>servo_0</jointName>
        <type>COMMAND</type>
        <cmd_topic>/model/mini_talon_ap/servo_0</cmd_topic>
        <multiplier>0.8727</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
      </control>
      <control channel="1">
        <jointName>servo_1</jointName>
        <type>COMMAND</type>
        <cmd_topic>/model/mini_talon_ap/servo_1</cmd_topic>
        <multiplier>-0.8727</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
      </control>
      <control channel="2">
        <jointName>servo_2</jointName>
        <type>COMMAND</type>
        <cmd_topic>/model/mini_talon_ap/servo_2</cmd_topic>
        <multiplier>-0.8727</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
      </control>
      <control channel="3">
        <jointName>servo_3</jointName>
        <type>COMMAND</type>
        <cmd_topic>/model/mini_talon_ap/servo_3</cmd_topic>
        <multiplier>-0.8727</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
      </control>
      <control channel="4">
        <jointName>rotor_joint</jointName>
        <type>COMMAND</type>
        <cmd_topic>/model/mini_talon_ap/joint/rotor_joint/cmd_thrust</cmd_topic>
        <multiplier>18.00</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
      </control>
    </plugin>
  </model>
</sdf>
