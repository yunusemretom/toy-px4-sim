<?xml version="1.0"?>
<!-- ArduPilot surumu (tools/gen_ardupilot.py).  Skywalker X8: tools/gen_plane.py ile uretildi (tanim: tools/plane_specs.py). Elle duzenlemeyin.
     S=0.806 m^2, MAC=0.408 m, AR=5.58, kutle=3.2 kg
     Notr nokta burundan 0.467 m, agirlik merkezi 0.443 m (statik marj %6 MAC)
     Trim: wing.twist=-4.20 deg, seyir CL=0.20 @ 18 m/s, alpha=-0.3 deg -->
<sdf version="1.9">
  <model name="x8_ap">
    <pose>0 0 0.175 0 0 0</pose>
    <link name="base_link">
      <inertial><mass>3.2</mass><inertia><ixx>0.3092</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.1332</iyy><iyz>0</iyz><izz>0.3805</izz></inertia></inertial>
      <collision name="base_link_collision"><pose>0.048 0 -0.000 0 0 0</pose>
        <geometry><box><size>0.790 0.220 0.120</size></box></geometry>
        <surface><contact><ode><max_vel>10</max_vel><min_depth>0.01</min_depth></ode></contact>
          <friction><ode><mu>0.1</mu><mu2>0.1</mu2></ode></friction></surface></collision>
      <collision name='nose_skid'><pose>0.348 0 -0.093 0 0 0</pose><geometry><box><size>0.04 0.04 0.105</size></box></geometry><surface><friction><ode><mu>0.1</mu><mu2>0.1</mu2></ode></friction></surface></collision>
      <visual name='nose_skid_visual'><pose>0.348 0 -0.093 0 0 0</pose><geometry><box><size>0.04 0.04 0.105</size></box></geometry><material><ambient>0.060 0.060 0.060 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
      <visual name='fuselage_visual'><pose>0 0 0 0 0 0</pose><geometry><mesh><uri>model://x8/meshes/fuselage.obj</uri></mesh></geometry><material><ambient>0.060 0.060 0.060 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
      <visual name='surfaces_visual'><pose>0 0 0 0 0 0</pose><geometry><mesh><uri>model://x8/meshes/surfaces.obj</uri></mesh></geometry><material><ambient>0.570 0.570 0.570 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
      <gravity>1</gravity>
      <sensor name="imu_sensor" type="imu">
        <pose degrees="true">0 0 0 180 0 0</pose>
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>
    <link name="rotor"><pose>-0.377 0 0.000 0 1.5708 0</pose>
      <inertial><mass>0.02</mass><inertia><ixx>1.5e-04</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.5e-04</iyy><iyz>0</iyz><izz>3e-04</izz></inertia></inertial>
      <visual name="rotor_visual"><geometry><cylinder><length>0.004</length><radius>0.140</radius></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 0.6</ambient><diffuse>0.1 0.1 0.1 0.6</diffuse></material><transparency>0.4</transparency></visual>
    </link>
    <joint name="rotor_joint" type="revolute"><child>rotor</child><parent>base_link</parent>
      <axis><xyz expressed_in="__model__">1 0 0</xyz><limit><lower>-1e+16</lower><upper>1e+16</upper></limit></axis></joint>
    <link name='el_l'><pose>-0.2751 0.6360 -0.0118 0 0 0</pose>
      <inertial><mass>0.00000001</mass><inertia><ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000001</iyy><iyz>0</iyz><izz>0.000001</izz></inertia></inertial>
      <visual name='el_l_visual'><pose>0.2751 -0.6360 0.0118 0 0 0</pose><geometry><mesh><uri>model://x8/meshes/el_l.obj</uri></mesh></geometry><material><ambient>0.510 0.060 0.060 1</ambient><diffuse>0.85 0.1 0.1 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
    </link>
    <link name='el_r'><pose>-0.2751 -0.6360 -0.0118 0 0 0</pose>
      <inertial><mass>0.00000001</mass><inertia><ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000001</iyy><iyz>0</iyz><izz>0.000001</izz></inertia></inertial>
      <visual name='el_r_visual'><pose>0.2751 0.6360 0.0118 0 0 0</pose><geometry><mesh><uri>model://x8/meshes/el_r.obj</uri></mesh></geometry><material><ambient>0.510 0.060 0.060 1</ambient><diffuse>0.85 0.1 0.1 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
    </link>
    <joint name='servo_0' type='revolute'><parent>base_link</parent><child>el_l</child>
      <axis><xyz expressed_in='__model__'>0.2033 -0.9787 -0.0271</xyz><limit><lower>-0.44</lower><upper>0.44</upper></limit><dynamics><damping>1.0</damping></dynamics></axis>
      <physics><ode><implicit_spring_damper>1</implicit_spring_damper></ode></physics></joint>
    <joint name='servo_1' type='revolute'><parent>base_link</parent><child>el_r</child>
      <axis><xyz expressed_in='__model__'>-0.2033 -0.9787 0.0271</xyz><limit><lower>-0.44</lower><upper>0.44</upper></limit><dynamics><damping>1.0</damping></dynamics></axis>
      <physics><ode><implicit_spring_damper>1</implicit_spring_damper></ode></physics></joint>
    <plugin filename='gz-sim-joint-position-controller-system' name='gz::sim::systems::JointPositionController'><joint_name>servo_0</joint_name><sub_topic>servo_0</sub_topic><p_gain>10</p_gain><i_gain>0</i_gain><d_gain>0</d_gain></plugin>
    <plugin filename='gz-sim-joint-position-controller-system' name='gz::sim::systems::JointPositionController'><joint_name>servo_1</joint_name><sub_topic>servo_1</sub_topic><p_gain>10</p_gain><i_gain>0</i_gain><d_gain>0</d_gain></plugin>
    <plugin filename="gz-sim-advanced-lift-drag-system" name="gz::sim::systems::AdvancedLiftDrag">
      <CL0>0.22035</CL0>
      <CLa>4.18222</CLa>
      <AR>5.57895</AR>
      <eff>0.9433</eff>
      <CD0>0.0219432</CD0>
      <Cem0>-0.00123</Cem0>
      <Cema>-0.24944</Cema>
      <CYb>-0.162578</CYb>
      <Cellb>-0.069353</Cellb>
      <Cenb>0.01713</Cenb>
      <CYp>0.016561</CYp>
      <CLp>-5e-06</CLp>
      <Cellp>-0.395377</Cellp>
      <Cemp>2e-06</Cemp>
      <Cenp>-0.013741</Cenp>
      <CYq>-8.4e-05</CYq>
      <CLq>4.68194</CLq>
      <Cellq>3e-06</Cellq>
      <Cemq>-1.25872</Cemq>
      <Cenq>7.4e-05</Cenq>
      <CYr>0.052622</CYr>
      <CLr>0</CLr>
      <Cellr>0.052515</Cellr>
      <Cemr>-0</Cemr>
      <Cenr>-0.007088</Cenr>
      <CDp>0.000119</CDp>
      <CDq>0.100814</CDq>
      <CDr>-5e-06</CDr>
      <alpha_stall>0.148</alpha_stall>
      <CLa_stall>-3.85</CLa_stall><CDa_stall>-0.92</CDa_stall><Cema_stall>0</Cema_stall>
      <cp>0 0 0</cp><area>0.8056</area><mac>0.4084</mac><air_density>1.2041</air_density>
      <forward>1 0 0</forward><upward>0 0 1</upward><link_name>base_link</link_name>
      <num_ctrl_surfaces>2</num_ctrl_surfaces>
      <control_surface><name>servo_0</name><index>0</index><direction>1</direction><CD_ctrl>0.000253</CD_ctrl><CY_ctrl>0.000272</CY_ctrl><CL_ctrl>0.012932</CL_ctrl><Cell_ctrl>0.002921</Cell_ctrl><Cem_ctrl>-0.004918</Cem_ctrl><Cen_ctrl>-0.000106</Cen_ctrl></control_surface>
      <control_surface><name>servo_1</name><index>1</index><direction>1</direction><CD_ctrl>0.000253</CD_ctrl><CY_ctrl>-0.000272</CY_ctrl><CL_ctrl>0.012932</CL_ctrl><Cell_ctrl>-0.002921</Cell_ctrl><Cem_ctrl>-0.004918</Cem_ctrl><Cen_ctrl>0.000107</Cen_ctrl></control_surface>
    </plugin>
    <link name="camera_link"><pose>0.453 0 -0.000 0 0.26 0</pose>
      <inertial><mass>0.03</mass><inertia><ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00001</iyy><iyz>0</iyz><izz>0.00001</izz></inertia></inertial>
      <sensor name="camera" type="camera"><gz_frame_id>camera_link</gz_frame_id>
        <camera><horizontal_fov>1.5708</horizontal_fov><image><width>640</width><height>480</height></image>
          <clip><near>0.1</near><far>1500</far></clip></camera>
        <always_on>1</always_on><update_rate>20</update_rate><visualize>false</visualize></sensor>
    </link>
    <joint name="CameraJoint" type="fixed"><parent>base_link</parent><child>camera_link</child></joint>

    <!-- Motor: ArduPilot gaz kanali itkiyi (N, 0..35) dogrudan komut eder. -->
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <namespace>x8_ap</namespace>
      <joint_name>rotor_joint</joint_name>
      <thrust_coefficient>0.1</thrust_coefficient>
      <fluid_density>1.2041</fluid_density>
      <propeller_diameter>0.280</propeller_diameter>
      <max_thrust_cmd>35.00</max_thrust_cmd>
      <min_thrust_cmd>0</min_thrust_cmd>
    </plugin>
    <!-- ArduPilot JSON koprusu. Govde ekseni x ileri / y sola / z yukari -> FRD icin x etrafinda
         180 deg; dunya ENU -> NED. fdm_port_in cok aracli calistirmada ornek basina degistirilir. -->
    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>
      <imuName>imu_sensor</imuName>
      <control channel="0">
        <jointName>servo_0</jointName>
        <type>COMMAND</type>
        <cmd_topic>/model/x8_ap/servo_0</cmd_topic>
        <multiplier>-0.8727</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
      </control>
      <control channel="1">
        <jointName>servo_1</jointName>
        <type>COMMAND</type>
        <cmd_topic>/model/x8_ap/servo_1</cmd_topic>
        <multiplier>-0.8727</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
      </control>
      <control channel="2">
        <jointName>rotor_joint</jointName>
        <type>COMMAND</type>
        <cmd_topic>/model/x8_ap/joint/rotor_joint/cmd_thrust</cmd_topic>
        <multiplier>35.00</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
      </control>
    </plugin>
  </model>
</sdf>
