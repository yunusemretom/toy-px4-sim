<?xml version="1.0"?>
<!-- Skywalker 1900: tools/gen_plane.py ile uretildi (tanim: tools/plane_specs.py). Elle duzenlemeyin.
     S=0.447 m^2, MAC=0.237 m, AR=8.09, kutle=2.0 kg
     Notr nokta burundan 0.424 m, agirlik merkezi 0.401 m (statik marj %10 MAC)
     Trim: htail.incidence=-0.06 deg, seyir CL=0.43 @ 13 m/s, alpha=1.6 deg -->
<sdf version="1.9">
  <model name="skywalker1900">
    <pose>0 0 0.115 0 0 0</pose>
    <link name="base_link">
      <inertial><mass>2.0</mass><inertia><ixx>0.1663</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.1075</iyy><iyz>0</iyz><izz>0.2630</izz></inertia></inertial>
      <collision name="base_link_collision"><pose>-0.179 0 -0.019 0 0 0</pose>
        <geometry><box><size>1.160 0.110 0.130</size></box></geometry>
        <surface><contact><ode><max_vel>10</max_vel><min_depth>0.01</min_depth></ode></contact>
          <friction><ode><mu>0.1</mu><mu2>0.1</mu2></ode></friction></surface></collision>
      <visual name='fuselage_visual'><pose>0 0 0 0 0 0</pose><geometry><mesh><uri>model://skywalker1900/meshes/fuselage.obj</uri></mesh></geometry><material><ambient>0.558 0.558 0.558 1</ambient><diffuse>0.93 0.93 0.93 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
      <visual name='surfaces_visual'><pose>0 0 0 0 0 0</pose><geometry><mesh><uri>model://skywalker1900/meshes/surfaces.obj</uri></mesh></geometry><material><ambient>0.558 0.558 0.558 1</ambient><diffuse>0.93 0.93 0.93 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
      <gravity>1</gravity>
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.01</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <x>
            <noise type="gaussian">
              <stddev>3e-7</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <stddev>3e-7</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <stddev>3e-7</stddev>
            </noise>
          </z>
        </magnetometer>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>
    <link name="rotor"><pose>-0.219 0 0.105 0 1.5708 0</pose>
      <inertial><mass>0.02</mass><inertia><ixx>1.5e-04</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.5e-04</iyy><iyz>0</iyz><izz>3e-04</izz></inertia></inertial>
      <visual name="rotor_visual"><geometry><cylinder><length>0.004</length><radius>0.115</radius></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 0.6</ambient><diffuse>0.1 0.1 0.1 0.6</diffuse></material><transparency>0.4</transparency></visual>
    </link>
    <joint name="rotor_joint" type="revolute"><child>rotor</child><parent>base_link</parent>
      <axis><xyz expressed_in="__model__">1 0 0</xyz><limit><lower>-1e+16</lower><upper>1e+16</upper></limit></axis></joint>
    <link name='ail_l'><pose>-0.0931 0.6507 0.0757 0 0 0</pose>
      <inertial><mass>0.00000001</mass><inertia><ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000001</iyy><iyz>0</iyz><izz>0.000001</izz></inertia></inertial>
      <visual name='ail_l_visual'><pose>0.0931 -0.6507 -0.0757 0 0 0</pose><geometry><mesh><uri>model://skywalker1900/meshes/ail_l.obj</uri></mesh></geometry><material><ambient>0.090 0.210 0.510 1</ambient><diffuse>0.15 0.35 0.85 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
    </link>
    <link name='ail_r'><pose>-0.0931 -0.6507 0.0757 0 0 0</pose>
      <inertial><mass>0.00000001</mass><inertia><ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000001</iyy><iyz>0</iyz><izz>0.000001</izz></inertia></inertial>
      <visual name='ail_r_visual'><pose>0.0931 0.6507 -0.0757 0 0 0</pose><geometry><mesh><uri>model://skywalker1900/meshes/ail_r.obj</uri></mesh></geometry><material><ambient>0.090 0.210 0.510 1</ambient><diffuse>0.15 0.35 0.85 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
    </link>
    <link name='elevator'><pose>-0.7143 -0.0000 0.2156 0 0 0</pose>
      <inertial><mass>0.00000001</mass><inertia><ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000001</iyy><iyz>0</iyz><izz>0.000001</izz></inertia></inertial>
      <visual name='elevator_visual'><pose>0.7143 0.0000 -0.2156 0 0 0</pose><geometry><mesh><uri>model://skywalker1900/meshes/elevator.obj</uri></mesh></geometry><material><ambient>0.090 0.210 0.510 1</ambient><diffuse>0.15 0.35 0.85 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
    </link>
    <link name='rudder'><pose>-0.6950 -0.0000 0.1155 0 0 0</pose>
      <inertial><mass>0.00000001</mass><inertia><ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000001</iyy><iyz>0</iyz><izz>0.000001</izz></inertia></inertial>
      <visual name='rudder_visual'><pose>0.6950 0.0000 -0.1155 0 0 0</pose><geometry><mesh><uri>model://skywalker1900/meshes/rudder.obj</uri></mesh></geometry><material><ambient>0.090 0.210 0.510 1</ambient><diffuse>0.15 0.35 0.85 1</diffuse><specular>0.2 0.2 0.2 1</specular></material></visual>
    </link>
    <joint name='servo_0' type='revolute'><parent>base_link</parent><child>ail_l</child>
      <axis><xyz expressed_in='__model__'>-0.0131 -0.9983 -0.0566</xyz><limit><lower>-0.44</lower><upper>0.44</upper></limit><dynamics><damping>1.0</damping></dynamics></axis>
      <physics><ode><implicit_spring_damper>1</implicit_spring_damper></ode></physics></joint>
    <joint name='servo_1' type='revolute'><parent>base_link</parent><child>ail_r</child>
      <axis><xyz expressed_in='__model__'>0.0131 -0.9983 0.0566</xyz><limit><lower>-0.44</lower><upper>0.44</upper></limit><dynamics><damping>1.0</damping></dynamics></axis>
      <physics><ode><implicit_spring_damper>1</implicit_spring_damper></ode></physics></joint>
    <joint name='servo_2' type='revolute'><parent>base_link</parent><child>elevator</child>
      <axis><xyz expressed_in='__model__'>-0.0000 -1.0000 0.0000</xyz><limit><lower>-0.44</lower><upper>0.44</upper></limit><dynamics><damping>1.0</damping></dynamics></axis>
      <physics><ode><implicit_spring_damper>1</implicit_spring_damper></ode></physics></joint>
    <joint name='servo_3' type='revolute'><parent>base_link</parent><child>rudder</child>
      <axis><xyz expressed_in='__model__'>-0.0830 -0.0000 0.9965</xyz><limit><lower>-0.44</lower><upper>0.44</upper></limit><dynamics><damping>1.0</damping></dynamics></axis>
      <physics><ode><implicit_spring_damper>1</implicit_spring_damper></ode></physics></joint>
    <plugin filename='gz-sim-joint-position-controller-system' name='gz::sim::systems::JointPositionController'><joint_name>servo_0</joint_name><sub_topic>servo_0</sub_topic><p_gain>10</p_gain><i_gain>0</i_gain><d_gain>0</d_gain></plugin>
    <plugin filename='gz-sim-joint-position-controller-system' name='gz::sim::systems::JointPositionController'><joint_name>servo_1</joint_name><sub_topic>servo_1</sub_topic><p_gain>10</p_gain><i_gain>0</i_gain><d_gain>0</d_gain></plugin>
    <plugin filename='gz-sim-joint-position-controller-system' name='gz::sim::systems::JointPositionController'><joint_name>servo_2</joint_name><sub_topic>servo_2</sub_topic><p_gain>10</p_gain><i_gain>0</i_gain><d_gain>0</d_gain></plugin>
    <plugin filename='gz-sim-joint-position-controller-system' name='gz::sim::systems::JointPositionController'><joint_name>servo_3</joint_name><sub_topic>servo_3</sub_topic><p_gain>10</p_gain><i_gain>0</i_gain><d_gain>0</d_gain></plugin>
    <plugin filename="libAirSpeedPlugin.so" name="px4::AirSpeed"><link_name>base_link</link_name></plugin>
    <plugin filename="gz-sim-advanced-lift-drag-system" name="gz::sim::systems::AdvancedLiftDrag">
      <CL0>0.28971</CL0>
      <CLa>5.0423</CLa>
      <AR>8.08511</AR>
      <eff>0.9565</eff>
      <CD0>0.0299953</CD0>
      <Cem0>0.01547</Cem0>
      <Cema>-0.503489</Cema>
      <CYb>-0.179036</CYb>
      <Cellb>-0.074764</Cellb>
      <Cenb>0.044316</Cenb>
      <CYp>-0.052391</CYp>
      <CLp>-4.6e-05</CLp>
      <Cellp>-0.517931</Cellp>
      <Cemp>-4e-06</Cemp>
      <Cenp>-0.019647</Cenp>
      <CYq>3e-06</CYq>
      <CLq>6.62961</CLq>
      <Cellq>9e-06</Cellq>
      <Cemq>-8.5208</Cemq>
      <Cenq>3e-06</Cenq>
      <CYr>0.120596</CYr>
      <CLr>4e-06</CLr>
      <Cellr>0.085221</Cellr>
      <Cemr>0</Cemr>
      <Cenr>-0.037147</Cenr>
      <CDp>5e-06</CDp>
      <CDq>0.135388</CDq>
      <CDr>-0</CDr>
      <alpha_stall>0.192</alpha_stall>
      <CLa_stall>-3.85</CLa_stall><CDa_stall>-0.92</CDa_stall><Cema_stall>0</Cema_stall>
      <cp>0 0 0</cp><area>0.4465</area><mac>0.2367</mac><air_density>1.2041</air_density>
      <forward>1 0 0</forward><upward>0 0 1</upward><link_name>base_link</link_name>
      <num_ctrl_surfaces>4</num_ctrl_surfaces>
      <control_surface><name>servo_0</name><index>0</index><direction>1</direction><CD_ctrl>0.000257</CD_ctrl><CY_ctrl>0.000416</CY_ctrl><CL_ctrl>0.010574</CL_ctrl><Cell_ctrl>0.002928</Cell_ctrl><Cem_ctrl>-0.0017</Cem_ctrl><Cen_ctrl>-5.5e-05</Cen_ctrl></control_surface>
      <control_surface><name>servo_1</name><index>1</index><direction>1</direction><CD_ctrl>0.000257</CD_ctrl><CY_ctrl>-0.000416</CY_ctrl><CL_ctrl>0.010574</CL_ctrl><Cell_ctrl>-0.002928</Cell_ctrl><Cem_ctrl>-0.0017</Cem_ctrl><Cen_ctrl>5.5e-05</Cen_ctrl></control_surface>
      <control_surface><name>servo_2</name><index>2</index><direction>1</direction><CD_ctrl>4.9e-05</CD_ctrl><CY_ctrl>-0</CY_ctrl><CL_ctrl>0.006624</CL_ctrl><Cell_ctrl>-0</Cell_ctrl><Cem_ctrl>-0.017872</Cem_ctrl><Cen_ctrl>0</Cen_ctrl></control_surface>
      <control_surface><name>servo_3</name><index>3</index><direction>1</direction><CD_ctrl>-0</CD_ctrl><CY_ctrl>-0.001928</CY_ctrl><CL_ctrl>0</CL_ctrl><Cell_ctrl>-0.00016</Cell_ctrl><Cem_ctrl>-0</Cem_ctrl><Cen_ctrl>0.000689</Cen_ctrl></control_surface>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_joint</jointName><linkName>rotor</linkName><turningDirection>cw</turningDirection>
      <timeConstantUp>0.03</timeConstantUp><timeConstantDown>0.05</timeConstantDown>
      <maxRotVelocity>1100</maxRotVelocity><motorConstant>2.2000e-05</motorConstant>
      <momentConstant>0.02</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber><rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient><rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <link name="camera_link"><pose>0.411 0 -0.019 0 0.26 0</pose>
      <inertial><mass>0.03</mass><inertia><ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00001</iyy><iyz>0</iyz><izz>0.00001</izz></inertia></inertial>
      <sensor name="camera" type="camera"><gz_frame_id>camera_link</gz_frame_id>
        <camera><horizontal_fov>1.5708</horizontal_fov><image><width>640</width><height>480</height></image>
          <clip><near>0.1</near><far>1500</far></clip></camera>
        <always_on>1</always_on><update_rate>20</update_rate><visualize>false</visualize></sensor>
    </link>
    <joint name="CameraJoint" type="fixed"><parent>base_link</parent><child>camera_link</child></joint>
  </model>
</sdf>
