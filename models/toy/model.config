<?xml version="1.0"?>
<model>
  <name>Toy</name>
  <version>1.0</version>
  <sdf version='1.9'>model.sdf</sdf>

  <description>
    Pusher fixed-wing (1.4 m span, Clark Y, tapered wing with winglets) built from the
