#!/bin/sh
#
# @name X-UAV Mini Talon SITL
#
# @type Standard Plane
# @class Plane
#
# tools/gen_plane.py ile uretildi (tanim: tools/plane_specs.py). Elle duzenlemeyin.
# Hiz ve kazanclar hesaplanmistir; gercek ucak icin baslangic degerleridir.
#

. ${R}etc/init.d/rc.fw_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=toy_parkur}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=mini_talon}
PX4_GZ_FOLLOW_OFFSET_X=${PX4_GZ_FOLLOW_OFFSET_X:=-1.8}
PX4_GZ_FOLLOW_OFFSET_Y=${PX4_GZ_FOLLOW_OFFSET_Y:=-1.4}
PX4_GZ_FOLLOW_OFFSET_Z=${PX4_GZ_FOLLOW_OFFSET_Z:=0.8}

param set-default SIM_GZ_EN 1

# Hizlar (m/s): kanat yuku 4.7 kg/m^2, stall ~8.7 m/s
param set-default FW_AIRSPD_STALL 9
param set-default FW_AIRSPD_MIN 11
param set-default FW_AIRSPD_TRIM 15
param set-default FW_AIRSPD_MAX 20

# Gaz: tahmini (suruklenme / motor modeli)
param set-default FW_THR_MIN 0.05
param set-default FW_THR_TRIM 0.33
param set-default FW_THR_MAX 0.9

# Acisal hiz kazanclari: toy'un kazanclari * kontrol gucu orani
#   (yatis x0.71, yunuslama x0.33, yon x0.62)
param set-default FW_RR_P 0.035
param set-default FW_RR_I 0.177
param set-default FW_RR_FF 0.064
param set-default FW_PR_P 0.115
param set-default FW_PR_I 0.165
param set-default FW_PR_FF 0.132
param set-default FW_YR_P 0.156
param set-default FW_YR_I 0.250
param set-default FW_YR_FF 0.250
param set-default FW_R_LIM 40
param set-default FW_P_LIM_MAX 30
param set-default FW_P_LIM_MIN -15
param set-default FW_T_CLMB_MAX 5
param set-default FW_T_SINK_MAX 3
param set-default FW_T_SINK_MIN 2
param set-default FW_W_EN 1
param set-default NAV_DLL_ACT 2
param set-default RWTO_TKOFF 1

# Motor: itki ekseni +x
param set-default CA_ROTOR_COUNT 1
param set-default CA_ROTOR0_PX -0.174
param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_MIN1 0
param set-default SIM_GZ_EC_MAX1 1000

# Kontrol yuzeyleri: tork katsayilari AVL turevlerinden (pozitif cikis = AVL pozitif sapmasi)
param set-default CA_SV_CS_COUNT 4
param set-default CA_SV_CS0_TYPE 1
param set-default CA_SV_CS0_TRQ_R 0.500
param set-default SIM_GZ_SV_FUNC1 201
param set-default SIM_GZ_SV_MAXA1 25
param set-default SIM_GZ_SV_MINA1 -25
param set-default CA_SV_CS1_TYPE 2
param set-default CA_SV_CS1_TRQ_R -0.500
param set-default SIM_GZ_SV_FUNC2 202
param set-default SIM_GZ_SV_MAXA2 25
param set-default SIM_GZ_SV_MINA2 -25
param set-default CA_SV_CS2_TYPE 7
param set-default CA_SV_CS2_TRQ_P -0.500
param set-default CA_SV_CS2_TRQ_Y -0.500
param set-default SIM_GZ_SV_FUNC3 203
param set-default SIM_GZ_SV_MAXA3 25
param set-default SIM_GZ_SV_MINA3 -25
param set-default CA_SV_CS3_TYPE 8
param set-default CA_SV_CS3_TRQ_P -0.500
param set-default CA_SV_CS3_TRQ_Y 0.500
param set-default SIM_GZ_SV_FUNC4 204
param set-default SIM_GZ_SV_MAXA4 25
param set-default SIM_GZ_SV_MINA4 -25
